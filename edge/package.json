{
  "name": "opensource-factory-edge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "test:notifications": "node --test scripts/notification-route.test.mjs",
    "test:push-preferences": "node --test scripts/push-preferences-route.test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply opensource-factory --local"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
