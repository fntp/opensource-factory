# OpenFactory 本机运行环境模板（生产 / 部署基线）
# 由 deploy/scripts/bootstrap-runtime.sh 渲染到 $OPENFACTORY_HOME/.env（权限 600）。
# 仓库只保存占位符；真实密钥只存在于本机运行目录，切勿提交。
#
# @RUNTIME_DIR@ 会在 bootstrap 时替换为实际运行目录（默认 /opt/openfactory）。

# ===== 运行目录 =====
OPENFACTORY_HOME=@RUNTIME_DIR@

# ===== 应用基础 =====
APP_NAME=OpenFactory VPS Node
VERSION=0.1.0
LOG_LEVEL=INFO
# 非空时 API 写滚动日志（10MB × 5）到该目录；留空仅输出 stdout
LOG_DIR=@RUNTIME_DIR@/logs

# ===== 数据库 / 队列 =====
# SQLite 绝对路径（注意 sqlite:/// + 绝对路径 = 四个斜杠）
DATABASE_URL=sqlite:///@RUNTIME_DIR@/data/opensource_factory.db
REDIS_URL=redis://127.0.0.1:6379/0

# ===== LLM：本地 Ollama（首选）=====
OLLAMA_BASE_URL=http://127.0.0.1:11434
# M3-01 选型：≤2B 量化模型（q4_K_M，约 1.3G）；qwen2.5:7b 约 4.7G，超 2G 预算
OLLAMA_MODEL=qwen2.5:1.5b-instruct-q4_K_M

# ===== LLM：DeepSeek 云端（可选降级，OpenAI 兼容）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 向量模型 =====
# 需安装 requirements-ml.txt；未安装时自动使用 hash 兜底向量
EMBEDDING_MODEL=BAAI/bge-m3
# int8 量化（约 1.1G）；fp16 约 2.3G 超预算，仅按需人工启用
EMBEDDING_QUANTIZATION=int8
EMBEDDING_DEVICE=cpu

# ===== AI 推理预算 =====
# 同一时刻仅加载 1 个模型，峰值驻留不得超过该值（MB）
MODEL_BUDGET_MB=2048

# 1 = 强制使用确定性 hash 向量（CI / 2G 预算紧张时；生产保持 0）
EMBEDDING_FORCE_FALLBACK=0

# ===== 向量化管线 =====
# 每批编码 / 提交条数（1~256）
VECTORIZE_BATCH_SIZE=32
# 单次运行默认上限，避免长时间占用 worker
VECTORIZE_MAX_PER_RUN=1000
# 1 = 同步 / 热榜抓取完成后自动入队增量向量化
VECTORIZE_AUTO=1

# ===== Vectorize 索引同步（M3-03）=====
# edge Worker 地址（与 INTERNAL_TOKEN 同时配置后才启用同步）
EDGE_BASE_URL=
VECTORIZE_SYNC_ENABLED=true
VECTORIZE_INDEX_NAME=opensource-factory-vectors
VECTORIZE_INDEX_DIM=1024
VECTORIZE_SYNC_BATCH_SIZE=100
VECTORIZE_SYNC_MAX_PER_RUN=1000
VECTORIZE_SYNC_MAX_RETRIES=3
VECTORIZE_SYNC_RETRY_BASE_MS=500
VECTORIZE_SYNC_TIMEOUT_SECONDS=30
VECTORIZE_SYNC_DELETE_ORPHANS=false
VECTORIZE_SYNC_MAX_ORPHANS=100

# ===== 推荐生成（M3-05）=====
# 最终推荐得分最低阈值（0~1）：相似度 × 权重 + 热榜热度 × 权重
RECOMMEND_MIN_SCORE=0.30
# 每日任务每个用户最多生成的推荐数
RECOMMEND_DAILY_TOP_K=20
# 单次参与打分的热榜候选上限
RECOMMEND_CANDIDATE_LIMIT=500
# 相似度 / 热榜热度权重（均为 0 时退化为纯相似度）
RECOMMEND_SIMILARITY_WEIGHT=0.8
RECOMMEND_TRENDING_WEIGHT=0.2

# ===== 内部接口鉴权 =====
# 留空时 bootstrap 会自动生成（openssl rand -hex 32）；边缘 → 节点调用必须一致
INTERNAL_TOKEN=

# ===== Celery =====
# 1 = 任务同步执行（仅本地调试 / 测试）；生产保持 0
CELERY_TASK_ALWAYS_EAGER=0

# ===== GitHub =====
# Personal Access Token（只需 public_repo / read 权限）；留空时同步任务跳过
GITHUB_TOKEN=

# ===== CORS =====
# 生产改为实际管理后台域名，多个用英文逗号分隔；禁止使用 *
CORS_ORIGINS=http://localhost:5173
