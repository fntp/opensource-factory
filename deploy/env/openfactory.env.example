# OpenFactory 本机运行环境模板（生产 / 部署基线）
# 由 deploy/scripts/bootstrap-runtime.sh 渲染到 $OPENFACTORY_HOME/.env（权限 600）。
# 仓库只保存占位符；真实密钥只存在于本机运行目录，切勿提交。
#
# @RUNTIME_DIR@ 会在 bootstrap 时替换为实际运行目录（默认 /opt/openfactory）。

# ===== 运行目录 =====
OPENFACTORY_HOME=@RUNTIME_DIR@

# ===== 应用基础 =====
APP_NAME=OpenFactory VPS Node
VERSION=1.0.0
LOG_LEVEL=INFO
# 非空时 API 写滚动日志（10MB × 5）到该目录；留空仅输出 stdout
LOG_DIR=@RUNTIME_DIR@/logs

# ===== 数据库 / 队列 =====
# SQLite 绝对路径（注意 sqlite:/// + 绝对路径 = 四个斜杠）
DATABASE_URL=sqlite:///@RUNTIME_DIR@/data/opensource_factory.db
REDIS_URL=redis://127.0.0.1:6379/0

# ===== LLM：本地 Ollama（首选）=====
OLLAMA_BASE_URL=http://127.0.0.1:11434
# M3-01 选型：≤2B 量化模型（q4_K_M，约 1.3G）；qwen2.5:7b 约 4.7G，超 2G 预算
OLLAMA_MODEL=qwen2.5:1.5b-instruct-q4_K_M
# 批量摘要结束后模型驻留时间；2m 内无请求即卸载，避免长期占用 2G 推理预算
OLLAMA_KEEP_ALIVE=2m

# ===== LLM：DeepSeek 云端（可选降级，OpenAI 兼容）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== README 摘要批量队列（2G 预算内串行处理）=====
SUMMARY_BATCH_SIZE=10
SUMMARY_MAX_PER_RUN=200
SUMMARY_DELAY_MS=500
SUMMARY_MAX_CHARS=800

# ===== 摘要质量抽检（M2-04）=====
SUMMARY_SAMPLE_RATE=0.1
SUMMARY_SAMPLE_MAX_PER_RUN=50
SUMMARY_SAMPLE_ALWAYS_BELOW=60
SUMMARY_QUALITY_PASS_SCORE=70
SUMMARY_QUALITY_MIN_CHARS=40

# ===== 向量模型 =====
# 需安装 requirements-ml.txt；未安装时自动使用 hash 兜底向量
EMBEDDING_MODEL=BAAI/bge-m3
# int8 量化（约 1.1G）；fp16 约 2.3G 超预算，仅按需人工启用
EMBEDDING_QUANTIZATION=int8
EMBEDDING_DEVICE=cpu
# 1 = 强制使用确定性 hash 向量（CI / 2G 预算紧张时；生产保持 0）
EMBEDDING_FORCE_FALLBACK=0

# ===== AI 推理预算 =====
# 同一时刻仅加载 1 个模型，峰值驻留不得超过该值（MB）
MODEL_BUDGET_MB=2048

# ===== 向量化管线 =====
# 每批编码 / 提交条数（1~256）
VECTORIZE_BATCH_SIZE=32
# 单次运行默认上限，避免长时间占用 worker
VECTORIZE_MAX_PER_RUN=1000
# 1 = 同步 / 热榜抓取完成后自动入队增量向量化
VECTORIZE_AUTO=1

# ===== Vectorize 索引同步（M3-03）=====
# 边缘 Worker 地址（如 https://opensource-factory-api.example.workers.dev）；留空时同步任务返回 disabled
EDGE_BASE_URL=
VECTORIZE_SYNC_ENABLED=1
# Cloudflare Vectorize 索引名与维度（BGE-M3 = 1024；需与 edge 绑定一致）
VECTORIZE_INDEX_NAME=opensource-factory-vectors
VECTORIZE_INDEX_DIM=1024
# 每批 upsert 条数（1~1000）、单次运行上限、重试次数与退避基数
VECTORIZE_SYNC_BATCH_SIZE=100
VECTORIZE_SYNC_MAX_PER_RUN=1000
VECTORIZE_SYNC_MAX_RETRIES=3
VECTORIZE_SYNC_RETRY_BASE_MS=500
VECTORIZE_SYNC_TIMEOUT_SECONDS=30
# 孤儿向量清理默认关闭；开启前确认索引仅由本系统使用
VECTORIZE_SYNC_DELETE_ORPHANS=0
VECTORIZE_SYNC_MAX_ORPHANS=100

# ===== 语义搜索（M3-04）=====
SEARCH_DEFAULT_TOP_K=10
SEARCH_MAX_TOP_K=50
# 最低余弦相似度（0~1；0 表示不过滤）
SEARCH_MIN_SCORE=0.0
# 本地全量余弦扫描上限，超过后依赖 Vectorize
SEARCH_MAX_VECTORS=50000
# 查询理解（M3-10）：同义词 / 技术栈词表扩展（false 时保持原查询）
SEARCH_QUERY_EXPANSION_ENABLED=true
# 单次查询最多追加的扩展词数量（1~50）
SEARCH_QUERY_EXPANSION_MAX_TERMS=12

# ===== README 全文检索（M6-01）=====
# 本地 SQLite FTS5 全文索引（trigram；1~2 字短词自动回退 LIKE）
FTS_ENABLED=true
FTS_DEFAULT_TOP_K=10
FTS_MAX_TOP_K=50
# snippet() 返回的 token 数
FTS_SNIPPET_TOKENS=32
# 单篇 README 入库上限（字符）
FTS_MAX_README_CHARS=50000
# 补索引任务每批提交条数 / 单次上限
FTS_SYNC_BATCH_SIZE=10
FTS_SYNC_MAX_PER_RUN=200
# 摘要 / 抓取后自动落 README 镜像
FTS_AUTO_INDEX=true
# 每日补索引时刻（Asia/Shanghai）
FTS_SYNC_HOUR=4
FTS_SYNC_MINUTE=47
# 重复 / 相似项目检测（M6-03）：单次扫描仓库上限
DUPLICATE_MAX_REPOS=500
# 名称相似度阈值（0.5~1）
DUPLICATE_NAME_THRESHOLD=0.86
# 项目简介 token 相似度阈值（0~1）
DUPLICATE_DESCRIPTION_THRESHOLD=0.75
# 向量余弦复核阈值（0~1）
DUPLICATE_VECTOR_THRESHOLD=0.88
# 低于该置信度的命中直接丢弃（0~1）
DUPLICATE_MIN_CONFIDENCE=0.70
# 单次返回的重复簇上限
DUPLICATE_MAX_CLUSTERS=50

# ===== 依赖分析（M6-07）=====
# 聚合默认返回的热门依赖数（1~100）
DEPENDENCY_ANALYSIS_TOP=20
# 单次扫描仓库上限（1~500）
DEPENDENCY_SCAN_MAX_REPOS=100
# 非强制扫描时，最近成功扫描的跳过窗口（小时）
DEPENDENCY_SCAN_TTL_HOURS=24
# 单份清单拉取超时（秒）
DEPENDENCY_SCAN_TIMEOUT_SECONDS=15
# 单份清单大小上限（字节）
DEPENDENCY_MANIFEST_MAX_BYTES=512000
# ===== 推荐生成（M3-05）=====
# 最终推荐得分最低阈值（0~1）：相似度 × 权重 + 热榜热度 × 权重
RECOMMEND_MIN_SCORE=0.30
# 每日任务每个用户最多生成的推荐数
RECOMMEND_DAILY_TOP_K=20
# 单次参与打分的热榜候选上限
RECOMMEND_CANDIDATE_LIMIT=500
# 相似度 / 热榜热度权重（均为 0 时退化为纯相似度）
RECOMMEND_SIMILARITY_WEIGHT=0.8
RECOMMEND_TRENDING_WEIGHT=0.2

# ===== 推荐质量评估（M3-08）=====
# 默认评估折叠数 / 每个折叠留出的正样本比例
RECOMMEND_EVAL_SAMPLE_SIZE=5
RECOMMEND_EVAL_HOLDOUT_RATIO=0.2
# 评估用 top_k / 每个正样本配的负样本数
RECOMMEND_EVAL_TOP_K=10
RECOMMEND_EVAL_NEGATIVES_PER_POSITIVE=5
# 抽样随机种子（同种子结果可复现）
RECOMMEND_EVAL_SEED=42
# min_score 扫描网格 / 相似度权重扫描网格（逗号分隔）
RECOMMEND_EVAL_MIN_SCORE_GRID=0.20,0.25,0.30,0.35,0.40,0.45,0.50
RECOMMEND_EVAL_WEIGHT_GRID=0.6,0.7,0.8,0.9,1.0
# 单次评估折叠数上限
RECOMMEND_EVAL_MAX_SAMPLES=20


# ===== 推荐反馈回流（M3-07）=====
# 1 = 生成推荐前拉取 edge 收藏 / 忽略反馈，生成后回写 D1；0 = 仅本地
RECOMMEND_FEEDBACK_SYNC=1

# ===== Rerank 精排（M7-07 / REQ-202610-0966）=====
# 总开关：false 时保持 M3-05 粗排行为
RERANK_ENABLED=true
# 进入精排的粗排候选池大小（实际取与每日 top_k 的较大值）
RERANK_POOL_SIZE=100
# MMR 多样性系数：1 = 只看精排分，越小越强调多样性
RERANK_MMR_LAMBDA=0.75
# 六路信号权重（按权重和归一化）
RERANK_WEIGHT_RELEVANCE=0.45
RERANK_WEIGHT_AFFINITY=0.15
RERANK_WEIGHT_FRESHNESS=0.12
RERANK_WEIGHT_MOMENTUM=0.10
RERANK_WEIGHT_POPULARITY=0.08
RERANK_WEIGHT_HEALTH=0.10

# ===== 每日推荐评估（M4-01）=====
# 匹配度硬门槛：原始余弦相似度低于该值直接 filtered
EVAL_MATCH_THRESHOLD=0.35
# 综合质量分门槛（仓库内容质量 × 权重 + 推荐理由质量 × 权重）
EVAL_QUALITY_THRESHOLD=0.55
EVAL_REPO_WEIGHT=0.7
EVAL_REASON_WEIGHT=0.3

# ===== Bark 推送通道（M4-03）=====
# 总开关；关闭时 09:05 的投递任务直接跳过
BARK_ENABLED=false
# Bark 服务地址（官方 https://api.day.app，自建服务填自己的地址）
BARK_SERVER_URL=https://api.day.app
# Bark device key（密钥，勿提交真实值）
BARK_DEVICE_KEY=
BARK_GROUP=OpenFactory
# 可选：提示音 / 图标 URL，留空使用 Bark 默认
BARK_SOUND=
BARK_ICON=
# active | timeSensitive | passive | critical
BARK_LEVEL=active
BARK_TIMEOUT_SECONDS=10
# 单次任务最多投递条数，避免一次刷屏
BARK_MAX_PER_RUN=5
# 试运行：只生成消息不发送、不写投递标记
BARK_DRY_RUN=false

# ===== Telegram 推送通道（M4-04）=====
# 默认关闭；配置 Bot Token 与 Chat ID 后设为 true
TELEGRAM_ENABLED=false
# BotFather 颁发的 Bot Token（机密，仅存本机 .env）
TELEGRAM_BOT_TOKEN=
# 接收推送的会话 id（私聊为正数；群组为负数，需先把 Bot 拉入群并允许发言）
TELEGRAM_CHAT_ID=
# Bot API 地址（默认官方；自建反代时修改）
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_TIMEOUT_SECONDS=10
TELEGRAM_MAX_RETRIES=3
TELEGRAM_RETRY_BASE_SECONDS=0.5
# 单条摘要最多包含的推荐数
TELEGRAM_DAILY_LIMIT=10
# 摘要只取最近 N 小时内进入 pushed 的推荐
TELEGRAM_DIGEST_WINDOW_HOURS=24

# ===== Email 通道（M4-05）=====
# 总开关；关闭时每日摘要任务与测试接口直接跳过，不发起 SMTP 连接
EMAIL_ENABLED=false
# SMTP 服务商地址（如 smtp.example.com）
EMAIL_SMTP_HOST=
# 587 = STARTTLS（默认）；465 通常配合 EMAIL_SSL=true 且 EMAIL_STARTTLS=false
EMAIL_SMTP_PORT=587
# 需要认证时填写；留空表示匿名中继
EMAIL_SMTP_USERNAME=
# 仅写在 .env，切勿提交；日志与接口均不会回显
EMAIL_SMTP_PASSWORD=
# 发件人地址（需与服务商允许的 From 一致）
EMAIL_FROM=
EMAIL_FROM_NAME=OpenFactory
# 默认收件人：逗号 / 分号分隔，最多 20 个
EMAIL_TO=
EMAIL_STARTTLS=true
EMAIL_SSL=false
EMAIL_TIMEOUT_SECONDS=15
# 瞬时网络错误重试次数（认证 / 收件人拒绝不重试）
EMAIL_MAX_RETRIES=2
EMAIL_RETRY_BASE_SECONDS=0.5
# 单封摘要最多包含的推荐数
EMAIL_DAILY_LIMIT=10
# 摘要回溯窗口（小时）
EMAIL_DIGEST_WINDOW_HOURS=24

# ===== 推送偏好（M4-06）=====
# 未保存偏好的用户使用的默认推送时间 / 时区
PUSH_DEFAULT_TIME=09:00
PUSH_DEFAULT_TIMEZONE=Asia/Shanghai
# 默认匹配度 / 质量分阈值（0~1）
PUSH_DEFAULT_MIN_SCORE=0.35
PUSH_DEFAULT_MIN_QUALITY_SCORE=0.55
# 定时推送窗口（分钟）：到达 time_of_day 后的容差
PUSH_TIME_WINDOW_MINUTES=10
# 读取 edge 推送偏好接口的超时（秒）
PUSH_PREFERENCES_TIMEOUT_SECONDS=10.0

# ===== 推送去重与静默（M4-07）=====
# 总开关；关闭时 daily_push 保持旧行为（只把 qualified 标记为 pushed）
PUSH_POLICY_ENABLED=true
# 静默时段（用户本地时区，HH:MM）；留空或开始 / 结束相同表示不静默
PUSH_QUIET_HOURS_START=22:00
PUSH_QUIET_HOURS_END=08:00
# 静默时段解释所用 IANA 时区；非法值回退 Asia/Shanghai
PUSH_TIMEZONE=Asia/Shanghai
# 每用户每日最多推送条数（按去重仓库计数；0 表示不限）
PUSH_DAILY_LIMIT=3
# 同一用户同一仓库的去重窗口（天；0 表示只做当日幂等）
PUSH_DEDUPE_DAYS=7
# true 时跨通道去重；false 时仅同通道去重
PUSH_DEDUPE_CROSS_CHANNEL=true
# 静默结束后的重试任务间隔（分钟）
PUSH_RETRY_INTERVAL_MINUTES=30

# ===== 内部接口鉴权 =====
# 留空时 bootstrap 会自动生成（openssl rand -hex 32）；边缘 → 节点调用必须一致
INTERNAL_TOKEN=
# 内部令牌轮换（M5-05）：过渡期同时接受上一枚令牌；轮换完成后清空
INTERNAL_TOKEN_PREVIOUS=

# ===== 接口限流（M5-05）=====
# 进程内滑动窗口；单节点部署。测试 / 排障可临时置 0
RATE_LIMIT_ENABLED=1
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=600
RATE_LIMIT_HEAVY_MAX_REQUESTS=120
# 经 Caddy 反代时信任 X-Forwarded-For 第一跳；直连调试可置 0
RATE_LIMIT_TRUST_PROXY=1

# ===== 本机一体化模式（M5-02 / REQ-202610-0940）=====
# 1 = 单进程提供 /local/api/* 只读接口并托管 admin 构建产物；0 = 混合架构（默认）
LOCAL_MODE=0
# 本机单用户身份（不做 GitHub OAuth）
LOCAL_USER_ID=local
LOCAL_USER_LOGIN=local
LOCAL_USER_NAME=本机用户
# admin 构建目录（由 local-allinone.sh build 复制到此）
LOCAL_ADMIN_DIR=@RUNTIME_DIR@/admin

# ===== Celery =====
# 1 = 任务同步执行（仅本地调试 / 测试）；生产保持 0
CELERY_TASK_ALWAYS_EAGER=0

# ===== GitHub =====
# Personal Access Token（只需 public_repo / read 权限）；留空时同步任务跳过
GITHUB_TOKEN=

# ===== 项目健康度（M6-05）=====
REPO_HEALTH_ENABLED=true
REPO_HEALTH_ACTIVE_DAYS=90
REPO_HEALTH_ATTENTION_DAYS=180
REPO_HEALTH_STALE_DAYS=365
REPO_HEALTH_MAX_PER_RUN=200
REPO_HEALTH_HOUR=6
REPO_HEALTH_MINUTE=12

# ===== 热榜抓取 =====
TRENDING_LANGUAGES=python,javascript,typescript,go,rust,java,cpp,c,php,ruby,swift,kotlin
TRENDING_CRAWL_HOUR=3
TRENDING_CRAWL_MINUTE=27
TRENDING_RETRY_MAX=3
TRENDING_RETRY_BASE_DELAY=1.0
TRENDING_RETRY_MAX_DELAY=8.0
TRENDING_COUNT_DROP_RATIO=0.3
TRENDING_COUNT_DROP_MIN_BASELINE=5
TRENDING_ALERT_COOLDOWN_MINUTES=360
TRENDING_ALERT_WEBHOOK_URL=

# ===== 热榜数据保留（M2-08）=====
TRENDING_RETENTION_DAYS=90
TRENDING_ARCHIVE_ENABLED=true
TRENDING_ARCHIVE_DIR=@RUNTIME_DIR@/data/archives
TRENDING_ARCHIVE_KEEP_DAYS=365
TRENDING_RETENTION_HOUR=4
TRENDING_RETENTION_MINUTE=17

# ===== 备份与恢复（M5-04）=====
# 1 = 启用每日 SQLite 快照与每周恢复演练；0 = 关闭定时任务
BACKUP_ENABLED=1
# 备份根目录（运行目录 backups/；D1 导出也归档到该目录）
BACKUP_DIR=@RUNTIME_DIR@/backups
# 每类备份保留份数（SQLite / D1 各自计算）
BACKUP_RETENTION_COUNT=7
# 备份总量上限（MB，0 = 不限制）；资源规划预算 3 GB
BACKUP_MAX_TOTAL_MB=3072
# 1 = 每周日自动执行恢复演练
BACKUP_DRILL_ENABLED=1
# 每日 SQLite 快照时刻（Asia/Shanghai）
BACKUP_HOUR=3
BACKUP_MINUTE=50
# 每周恢复演练时刻（Asia/Shanghai，周日）
BACKUP_DRILL_HOUR=4
BACKUP_DRILL_MINUTE=20
# ===== 监控与告警（M5-03）=====
MONITOR_ENABLED=true
MONITOR_INTERVAL_MINUTES=5
MONITOR_HOME=@RUNTIME_DIR@
# 内存红线（MB）：项目预算 4G，3.5G 预警、4G 严重
MONITOR_MEMORY_BUDGET_MB=4096
MONITOR_MEMORY_WARN_MB=3584
MONITOR_MEMORY_CRITICAL_MB=4096
# 磁盘红线（MB）：项目预算 15G，13G 预警、15G 严重
MONITOR_DISK_BUDGET_MB=15360
MONITOR_DISK_WARN_MB=13312
MONITOR_DISK_CRITICAL_MB=15360
MONITOR_LOG_BUDGET_MB=1024
MONITOR_LOG_RETENTION_DAYS=14
MONITOR_HISTORY_RETENTION_DAYS=30
MONITOR_ALERT_COOLDOWN_MINUTES=60
MONITOR_ALERT_WEBHOOK_URL=
MONITOR_EDGE_TIMEOUT_SECONDS=3
MONITOR_REDIS_TIMEOUT_SECONDS=2
MONITOR_PROCESS_PATTERNS=uvicorn+app.main:app,celery+app.tasks.celery_app+worker,celery+beat,redis-server,ollama

# ===== CORS =====
# 生产改为实际管理后台域名，多个用英文逗号分隔；禁止使用 *
CORS_ORIGINS=http://localhost:5173
