# OpenFactory 生产部署控制配置（REQ-202610-0939 / M5-01）
#
# 用法：复制到 /opt/openfactory/deploy.env（权限 600）后填写真实值，
#       或通过 `deploy/scripts/*.sh --env-file <路径>` 指定。
# 本文件只提交占位符；任何真实 token / 密钥不得入库。
#
# 说明：这是「部署控制面」配置，与应用运行配置 deploy/env/openfactory.env.example 分开；
#       应用密钥仍只存在于 $OPENFACTORY_HOME/.env。

# ===== Cloudflare 账号与资源（Q3）=====
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
# API Token 需具备 Workers Scripts:Edit、D1:Edit、Pages:Edit、Vectorize:Edit 权限
CLOUDFLARE_API_TOKEN=REPLACE_WITH_CLOUDFLARE_API_TOKEN
D1_DATABASE_NAME=opensource-factory
D1_DATABASE_ID=REPLACE_WITH_D1_DATABASE_ID
WORKER_NAME=opensource-factory-api
VECTORIZE_INDEX_NAME=opensource-factory-vectors
PAGES_PROJECT_NAME=opensource-factory-admin

# ===== 域名（Cloudflare 托管）=====
# admin 静态站点（Cloudflare Pages 自定义域）
ADMIN_ORIGIN=https://admin.example.com
# edge Worker 自定义域（同时作为 admin 的 VITE_API_BASE_URL）
API_ORIGIN=https://api.example.com
# 本机 VPS 节点公网地址（Caddy HTTPS 反代）
VPS_NODE_URL=https://node.example.com
# Caddy 申请证书使用的邮箱
CADDY_EMAIL=admin@example.com

# ===== GitHub OAuth App（Q3）=====
# Client ID 非机密，写入 Worker vars；Secret 由部署脚本通过 wrangler secret put 写入
GITHUB_CLIENT_ID=REPLACE_WITH_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_GITHUB_CLIENT_SECRET

# ===== 边缘会话与内部令牌 =====
# SESSION_SECRET：会话 / OAuth state 签名密钥（≥32 字符随机串）
SESSION_SECRET=REPLACE_WITH_SESSION_SECRET
# INTERNAL_TOKEN：默认从 $OPENFACTORY_HOME/.env 读取并与 Worker 保持一致；
# 仅当运行目录尚未初始化时才需要在此显式提供。
# INTERNAL_TOKEN=

# ===== 本机节点 =====
# 代码检出目录（systemd 单元的 @APP_DIR@ 指向此处）
VPS_APP_DIR=/opt/workspace/opensource-factory
# 运行目录（与代码分离，见 docs/guides/deployment-baseline.md）
OPENFACTORY_HOME=/opt/openfactory

# ===== CI 通过 SSH 部署 VPS 时使用 =====
VPS_SSH_HOST=node.example.com
VPS_SSH_USER=root
VPS_SSH_PORT=22
