# OpenFactory VPS 节点 —— 环境变量模板
# 复制为 .env 后填入真实值；.env 已被 git 忽略，切勿提交真实密钥。

# ===== 数据库 / 队列 =====
# 本地镜像库（默认 SQLite，可替换为 PostgreSQL 等）
DATABASE_URL=sqlite:///./data/opensource_factory.db
# Celery broker / result backend
REDIS_URL=redis://localhost:6379/0

# ===== LLM：本地 Ollama（首选）=====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# 批量摘要结束后模型驻留时间；2m 内无请求即卸载，避免长期占用 2G 推理预算
OLLAMA_KEEP_ALIVE=2m

# ===== LLM：DeepSeek 云端（可选降级，OpenAI 兼容）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== README 摘要批量队列（2G 预算内串行处理）=====
SUMMARY_BATCH_SIZE=10
SUMMARY_MAX_PER_RUN=200
SUMMARY_DELAY_MS=500
SUMMARY_MAX_CHARS=800

# ===== 摘要质量抽检（M2-04）=====
# 常规抽样比例（0~1）；低质量摘要会强制留存，不受该比例限制
SUMMARY_SAMPLE_RATE=0.1
# 单次任务最多留存样本数，避免样本表膨胀
SUMMARY_SAMPLE_MAX_PER_RUN=50
# 自动评分低于该值时强制留存（便于复盘降级输出）
SUMMARY_SAMPLE_ALWAYS_BELOW=60
# 自动判定通过线（人工复核可覆盖）
SUMMARY_QUALITY_PASS_SCORE=70
# 摘要最小长度（字符），低于该值长度检查不通过
SUMMARY_QUALITY_MIN_CHARS=40

# ===== 向量模型 =====
# 需安装 requirements-ml.txt；未安装时自动使用 hash 兜底向量
EMBEDDING_MODEL=BAAI/bge-m3

# ===== 内部接口鉴权 =====
# 设置后 /api/tasks/* 必须携带 X-Internal-Token 请求头；留空表示本地开发不鉴权
INTERNAL_TOKEN=
# edge Worker 地址（如 https://opensource-factory-api.xxx.workers.dev）；配置后摘要任务批量回写 D1
EDGE_BASE_URL=

# ===== Celery =====
# 1 = 任务同步执行（本地调试 / 测试用）；生产保持 0
CELERY_TASK_ALWAYS_EAGER=0

# ===== GitHub =====
# Personal Access Token（只需 public_repo / read 权限）；留空时同步任务跳过
GITHUB_TOKEN=

# ===== 其他（可选）=====
LOG_LEVEL=INFO
CORS_ORIGINS=*
