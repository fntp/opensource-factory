# OpenFactory VPS 节点 —— 环境变量模板
# 复制为 .env 后填入真实值；.env 已被 git 忽略，切勿提交真实密钥。

# ===== 数据库 / 队列 =====
# 本地镜像库（默认 SQLite，可替换为 PostgreSQL 等）
DATABASE_URL=sqlite:///./data/opensource_factory.db
# Celery broker / result backend
REDIS_URL=redis://localhost:6379/0

# ===== LLM：本地 Ollama（首选）=====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ===== LLM：DeepSeek 云端（可选降级，OpenAI 兼容）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 向量模型 =====
# 需安装 requirements-ml.txt；未安装时自动使用 hash 兜底向量
EMBEDDING_MODEL=BAAI/bge-m3

# ===== 内部接口鉴权 =====
# 设置后 /api/tasks/* 必须携带 X-Internal-Token 请求头；留空表示本地开发不鉴权
INTERNAL_TOKEN=

# ===== Celery =====
# 1 = 任务同步执行（本地调试 / 测试用）；生产保持 0
CELERY_TASK_ALWAYS_EAGER=0

# ===== GitHub =====
# Personal Access Token（只需 public_repo / read 权限；组织私有仓库需 read:org）；留空时同步任务跳过
GITHUB_TOKEN=
# 自有 / 组织仓库同步过滤策略（M1-06）：默认含自有 + 含组织、排除 fork、排除归档
GITHUB_SYNC_INCLUDE_OWN=true
GITHUB_SYNC_INCLUDE_ORGS=true
GITHUB_SYNC_INCLUDE_FORKS=false
GITHUB_SYNC_INCLUDE_ARCHIVED=false
# 组织白名单（逗号分隔，大小写不敏感）；留空表示全部组织
GITHUB_SYNC_ORG_ALLOWLIST=

# ===== 其他（可选）=====
LOG_LEVEL=INFO
CORS_ORIGINS=*
