# OpenFactory VPS 节点 —— 环境变量模板
# 复制为 .env 后填入真实值；.env 已被 git 忽略，切勿提交真实密钥。

# ===== 数据库 / 队列 =====
# 本地镜像库（默认 SQLite，可替换为 PostgreSQL 等）
DATABASE_URL=sqlite:///./data/opensource_factory.db
# Celery broker / result backend
REDIS_URL=redis://localhost:6379/0

# ===== LLM：本地 Ollama（首选）=====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ===== LLM：DeepSeek 云端（可选降级，OpenAI 兼容）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 向量模型 =====
# 需安装 requirements-ml.txt；未安装时自动使用 hash 兜底向量
EMBEDDING_MODEL=BAAI/bge-m3

# ===== 内部接口鉴权 =====
# 设置后 /api/tasks/* 必须携带 X-Internal-Token 请求头；留空表示本地开发不鉴权
INTERNAL_TOKEN=

# ===== Celery =====
# 1 = 任务同步执行（本地调试 / 测试用）；生产保持 0
CELERY_TASK_ALWAYS_EAGER=0

# ===== GitHub =====
# Personal Access Token（只需 public_repo / read 权限）；留空时同步任务跳过
GITHUB_TOKEN=

# ===== 热榜抓取 =====
# 抓取 GitHub Trending：全局页 + 下列语言页（逗号分隔；留空只抓全局页）
TRENDING_LANGUAGES=python,javascript,typescript,go,rust,java,cpp,c,php,ruby,swift,kotlin
# 容错重试：仅超时 / 429 / 5xx 重试；最大尝试次数、指数退避基数、单次等待上限（秒）
TRENDING_RETRY_MAX=3
TRENDING_RETRY_BASE_DELAY=1.0
TRENDING_RETRY_MAX_DELAY=8.0
# 页面结构变更判定：本次条数低于上次成功的比例；基线至少 N 条才判定
TRENDING_COUNT_DROP_RATIO=0.3
TRENDING_COUNT_DROP_MIN_BASELINE=5
# 告警去重窗口（分钟）与可选 webhook（留空则只落库 + 日志）
TRENDING_ALERT_COOLDOWN_MINUTES=360
TRENDING_ALERT_WEBHOOK_URL=

# ===== 其他（可选）=====
LOG_LEVEL=INFO
CORS_ORIGINS=*
