# ── 边缘服务地址（Cloudflare Worker API）─────────────────────────
# 例如 https://api.opensource-factory.example.com
# 留空表示与前端同源：生产环境需由反向代理把 /api 转发到 Worker；
# 本地开发由 vite.config.ts 的 /api 代理转发到 http://127.0.0.1:8787。
VITE_API_BASE_URL=

# ── 本地开发代理目标（可选）────────────────────────────────────
# 仅在 npm run dev 时生效，指向本机 wrangler dev 的 edge 服务。
VITE_EDGE_URL=http://127.0.0.1:8787
