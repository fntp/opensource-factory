# ── 边缘服务地址（Cloudflare Worker API）─────────────────────────
# 例如 https://api.opensource-factory.example.com
# 未配置时，前端将自动进入「演示模式」（使用内置演示数据，跳过登录）。
VITE_API_BASE_URL=

# ── 本地演示模式 ──────────────────────────────────────────────
# true 时可在登录页点击「进入演示模式」免后端预览界面。
# 生产环境请设为 false，并配置 VITE_API_BASE_URL。
VITE_DEMO_MODE=true
